<ui:FluentWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:shell="clr-namespace:SuKe.UI.Shell" x:Class="SuKe.UI.SettingsWindow" Title="溯刻 · SuKe" Width="1440" Height="900" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" FontFamily="Segoe UI, Microsoft YaHei UI" Background="{DynamicResource WaCanvasBrush}">

    <ui:FluentWindow.Resources>

        <shell:ReferenceAppIconsConverter x:Key="ReferenceAppIcons"/><!-- Value converters used by the workspace cards. They only project existing row data. -->
        <shell:WorkspaceAppIconsConverter x:Key="WorkspaceAppIcons"/>
        <shell:WorkspaceMetaTextConverter x:Key="WorkspaceMetaText"/>
        <shell:CompactWidthConverter x:Key="CompactWidth"/>

        <!-- Hide element when row is in editing mode -->
        <Style x:Key="HideWhenEditing" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Show element only when row is in editing mode -->
        <Style x:Key="ShowWhenEditing" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ── Row hover trigger ──────────────────────────────────────────── -->
        <Style x:Key="RowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── More-button (always visible) ────────────────────────────────── -->
        <Style x:Key="MoreBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorQuarternaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator in context menus -->
        <Style x:Key="MenuSep" TargetType="Separator"/>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- ── Title bar ──────────────────────────────────────────────────── -->
        <ui:TitleBar Grid.Row="0" Title="" ShowMinimize="True" ShowMaximize="True" Grid.Column="1" Height="58" Background="{DynamicResource WaCanvasBrush}"/>

        <Border x:Name="NavRail" Grid.Column="0" Width="264" Background="{DynamicResource WaSidebarBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Grid.Row="0" Grid.RowSpan="3">
                <Grid Margin="16,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,12,0,28" x:Name="BrandPanel">
                        <Image x:Name="BrandLogo" Source="pack://application:,,,/SuKe;component/Resources/suke-brand.png" Width="34" Height="34" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="溯刻 · SuKe" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="留住此刻，随时重来。" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <RadioButton x:Name="NavWorkspaces" Style="{StaticResource WaNavItem}" GroupName="WaMainNav" IsChecked="True" Tag="{x:Static ui:SymbolRegular.WindowApps24}" Content="{shell:LocalizedText 'Workspaces'}" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavActivity" Style="{StaticResource WaNavItem}" GroupName="WaMainNav" Tag="{x:Static ui:SymbolRegular.Clock24}" Content="{shell:LocalizedText 'Activity'}" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource WaNavItem}" GroupName="WaMainNav" Tag="{x:Static ui:SymbolRegular.Settings24}" Content="{shell:LocalizedText 'Settings'}" Checked="OnNavChecked"/>
                    </StackPanel>

                    </Grid>
            </Border>

            <Grid Grid.Column="1" Grid.Row="1">

                <!-- ──────── PAGE: WORKSPACES ──────── -->
                <Grid x:Name="WorkspacePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="40,24,28,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{shell:LocalizedText 'Saved Workspaces'}" Style="{StaticResource WaPageTitleCompact}"/>
                            <TextBlock Text="{shell:LocalizedText 'Restore the whole desktop layout in one step'}" Style="{StaticResource WaPageSubtitleCompact}"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Margin" Value="12,0,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CompactWidth}, ConverterParameter=1100}" Value="True">
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Margin" Value="0,12,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <ui:Button Content="{shell:LocalizedText 'Save Workspace'}" Icon="{ui:SymbolIcon Save24}" Click="OnSaveNewWorkspace" Appearance="Primary" ToolTip="{shell:LocalizedText 'Choose monitors and open-file options, then save'}" FontSize="14" MinHeight="60" Padding="28,12" Style="{DynamicResource WaPrimaryAction}"/>
                        <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}" Width="52" Height="60" Margin="10,0,0,0" ToolTip="{shell:LocalizedText 'Workspace actions'}" Click="OnWorkspaceToolsClick"><ui:Button.ContextMenu><ContextMenu><MenuItem StaysOpenOnClick="True"><MenuItem.Header><StackPanel Margin="8"><TextBlock x:Name="WorkspaceCountText" VerticalAlignment="Center" FontSize="12" Margin="4,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <CheckBox x:Name="SelectAllWorkspaces" Content="{shell:LocalizedText 'Select all'}" FontSize="12" Margin="4,6" VerticalAlignment="Center" Checked="OnSelectAllWorkspacesChanged" Unchecked="OnSelectAllWorkspacesChanged"/>
                    <ui:Button Content="{shell:LocalizedText 'Import Workspace'}" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowImport24}" Margin="4,6" Click="OnImportWorkspace" ToolTip="{shell:LocalizedText 'Preview the file first; matching names or IDs are always imported as a separate copy'}"/>
                            </StackPanel></MenuItem.Header></MenuItem></ContextMenu></ui:Button.ContextMenu></ui:Button></WrapPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,12,24,24" Focusable="False" shell:SmoothScrollBehavior.Enabled="True">
                        <StackPanel>

                <!-- Bulk selection bar (visible only while rows are checked) -->
                <Border x:Name="BulkActionBar" Visibility="Collapsed" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BulkSelectionText" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:Button Grid.Column="1" Content="{shell:LocalizedText 'Clear selection'}" Appearance="Secondary" Margin="0,0,8,0" Click="OnClearWorkspaceSelection"/>
                        <ui:Button Grid.Column="2" Content="{shell:LocalizedText 'Delete selected'}" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Click="OnDeleteSelectedWorkspaces"/>
                    </Grid>
                </Border>

                        <!-- Workspace cards -->
                        <ItemsControl x:Name="WorkspacesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource WaHoverCard}" Margin="0,0,0,12" Padding="20,18">
                                        <StackPanel>

                                            <!-- ── Identity and actions ── -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 勾选框占自己的一列并留出右间距：原先宽度为 0 + 负边距，视觉上贴死在卡片左沿和序号徽章之间。 -->
                                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,18,12,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnWorkspaceSelectionChanged" Unchecked="OnWorkspaceSelectionChanged" Opacity="0.45" ToolTip="{shell:LocalizedText 'Select workspace'}" HorizontalAlignment="Left"/>

                                                <!-- View mode: slot badge, name, and the monitor/window summary -->
                                                <StackPanel Grid.Column="2" Style="{StaticResource HideWhenEditing}" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <TextBlock Text="★" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Visibility="{Binding DefaultStarVisibility}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Converter={StaticResource WorkspaceMetaText}}" Style="{StaticResource WaItemMetaCompact}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                                </StackPanel>

                                                <!-- Edit mode: rename in place -->
                                                <StackPanel Grid.Column="2" Style="{StaticResource ShowWhenEditing}" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox x:Name="WsEditBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" MinWidth="200" MaxWidth="320" VerticalContentAlignment="Center" Padding="6,4" KeyDown="OnWsEditKeyDown" Tag="{Binding}"/>
                                                    <Button Margin="6,0,0,0" Width="32" Height="30" Style="{StaticResource WaIconButton}" Tag="{Binding}" Click="OnWsEditSave" ToolTip="{shell:LocalizedText 'Save'}">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="15" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                    </Button>
                                                    <Button Margin="4,0,0,0" Width="32" Height="30" Style="{StaticResource WaIconButton}" Tag="{Binding}" Click="OnWsEditCancel" ToolTip="{shell:LocalizedText 'Cancel'}">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Actions stay out of the way while renaming -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Style="{StaticResource HideWhenEditing}">
                                                    <ui:Button Content="{shell:LocalizedText 'Restore'}" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Margin="14,0,16,0" Tag="{Binding}" Click="OnWorkspaceRestoreClick" Style="{DynamicResource WaPrimaryAction}" FontSize="14" MinWidth="158"/>
                                                    <Button Style="{StaticResource WaIconButton}" Tag="{Binding}" Click="OnWorkspaceMoreClick" ToolTip="{shell:LocalizedText 'More actions'}" Width="56" Height="54">
                                                        <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="24" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            <Border CornerRadius="10" Padding="0" Margin="0,0,22,0" Background="{DynamicResource SystemAccentColorPrimaryBrush}" Grid.Column="1" Width="56" Height="56" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Position, StringFormat='#{0}'}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        </Grid>

                                            <!-- ── Apps this workspace brings back ── -->
                                            <ItemsControl Margin="124,16,0,12" Style="{StaticResource HideWhenEditing}" ItemsSource="{Binding Converter={StaticResource ReferenceAppIcons}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <!-- ── Monitor overview; screenshots stay behind an explicit action ── -->
                                            <shell:WorkspacePreviewControl Loaded="OnCardPreviewLoaded" Margin="0,0,0,10"/><Border Style="{StaticResource HideWhenEditing}" Background="Transparent" CornerRadius="6" Padding="0" Margin="0,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:Button Grid.Column="1" Content="{shell:LocalizedText 'Screen preview'}" Appearance="Secondary" VerticalAlignment="Center" Icon="{ui:SymbolIcon Eye24}" Tag="{Binding}" Click="OnWorkspaceScreenPreview" ToolTip="{shell:LocalizedText 'View the screenshots captured with this workspace'}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock x:Name="WorkspacesEmpty" Text="{shell:LocalizedText 'No saved workspaces yet. Save your first workspace above.'}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,24" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ──────── PAGE: ACTIVITY ──────── -->
                <ContentControl x:Name="ActivityPageHost" Visibility="Collapsed"/>

                <!-- ──────── PAGE: SETTINGS ──────── -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="40,24,28,0">
                        <TextBlock Text="{shell:LocalizedText 'Settings'}" Style="{StaticResource WaPageTitle}"/>
                        <TextBlock Text="{shell:LocalizedText 'Customise how workspaces are saved and restored'}" Style="{StaticResource WaPageSubtitle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="24,18,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="304" x:Name="SettingsCategoryColumn"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,20" Focusable="False">
                            <StackPanel>

                                <Border Style="{StaticResource WaCard}" Padding="14,16" Margin="0,0,0,14"><StackPanel x:Name="SectionSystem">

                <!-- ══════════════════ HELP ══════════════════ -->

                <!-- ══════════════════ SYSTEM ══════════════════ -->

                <StackPanel Orientation="Horizontal" Margin="6,0,0,16">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <TextBlock Text="{shell:LocalizedText 'System'}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ══════════════════ NOTIFICATIONS ══════════════════ -->

                <Border CornerRadius="10" Background="{DynamicResource WaCardInnerBrush}" BorderBrush="{DynamicResource WaCardInnerStrokeBrush}" BorderThickness="1" Padding="12,8" Margin="0"><StackPanel><Grid MinHeight="62" Margin="6,8,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="30" Width="42" Margin="4,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><StackPanel VerticalAlignment="Center" Grid.Column="1">
                            <TextBlock Text="{shell:LocalizedText 'Start with Windows'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{shell:LocalizedText 'Launch SuKe automatically when you log in'}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="AutostartToggle" Grid.Column="2" VerticalAlignment="Center" Checked="OnAutostartToggleChanged" Unchecked="OnAutostartToggleChanged" Margin="14,0,4,0"><ui:ToggleSwitch.LayoutTransform><ScaleTransform ScaleX="1.35" ScaleY="1.35"/></ui:ToggleSwitch.LayoutTransform></ui:ToggleSwitch>
                    </Grid>
                <Border Height="1" Margin="12,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/><Grid MinHeight="62" Margin="6,8,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Alert24" FontSize="30" Width="42" Margin="4,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><StackPanel VerticalAlignment="Center" Grid.Column="1">
                            <TextBlock Text="{shell:LocalizedText 'SuKe notifications'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{shell:LocalizedText 'Show workspace progress and completion messages in the system tray'}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="NotificationsToggle" Grid.Column="2" VerticalAlignment="Center" Checked="OnNotificationsToggleChanged" Unchecked="OnNotificationsToggleChanged" Margin="14,0,4,0"><ui:ToggleSwitch.LayoutTransform><ScaleTransform ScaleX="1.35" ScaleY="1.35"/></ui:ToggleSwitch.LayoutTransform></ui:ToggleSwitch>
                    </Grid>
                </StackPanel></Border></StackPanel>
                                </Border><Border Style="{StaticResource WaCard}" Padding="14,16" Margin="0,0,0,14"><StackPanel x:Name="SectionAppearance">

                <!-- ══════════════════ APPEARANCE & LANGUAGE ══════════════════ -->

                <StackPanel Orientation="Horizontal" Margin="6,0,0,16">
                    <ui:SymbolIcon Symbol="PaintBrush24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <TextBlock Text="{shell:LocalizedText 'Appearance &amp; Language'}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Background="{DynamicResource WaCardInnerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0">
                    <StackPanel>
                        <Grid MinHeight="62" Margin="6,8,6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="30" Width="42" Margin="4,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><StackPanel VerticalAlignment="Center" Margin="0,0,18,0" Grid.Column="1">
                                <TextBlock Text="{shell:LocalizedText 'Interface language'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{shell:LocalizedText 'Applies to every SuKe window immediately, including the tray menu.'}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="InterfaceLanguageCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnInterfaceLanguageChanged">
                                <ComboBoxItem Content="{shell:LocalizedText 'Simplified Chinese'}" Tag="ChineseSimplified"/>
                                <ComboBoxItem Content="{shell:LocalizedText 'English'}" Tag="English"/>
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Margin="12,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/><Grid MinHeight="62" Margin="6,8,6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="DarkTheme24" FontSize="30" Width="42" Margin="4,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><StackPanel VerticalAlignment="Center" Margin="0,0,18,0" Grid.Column="1">
                                <TextBlock Text="{shell:LocalizedText 'Theme'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{shell:LocalizedText 'Follow the Windows app theme, or always use one palette.'}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeModeCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnThemeModeChanged">
                                <ComboBoxItem Content="{shell:LocalizedText 'Follow system'}" Tag="FollowSystem"/>
                                <ComboBoxItem Content="{shell:LocalizedText 'Light'}" Tag="Light"/>
                                <ComboBoxItem Content="{shell:LocalizedText 'Dark'}" Tag="Dark"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                                </StackPanel></Border><Border Style="{StaticResource WaCard}" Padding="14,16" Margin="0,0,0,14"><StackPanel x:Name="SectionRestore">

                <!-- ══════════════════ RESTORE WORKFLOW ══════════════════ -->

                <Grid Margin="4,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="0">
                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <TextBlock Text="{shell:LocalizedText 'Restore Workflow'}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Style="{StaticResource WaIconButton}" Width="34" Height="30" Click="OnWorkspaceToolsClick" ToolTip="{shell:LocalizedText 'More restore options'}" Grid.Column="1"><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><Button.ContextMenu><ContextMenu><MenuItem StaysOpenOnClick="True"><MenuItem.Header><StackPanel Margin="12" Width="480"><Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="{shell:LocalizedText 'Temporary display recovery'}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{shell:LocalizedText 'When a temporary resolution, docking, or monitor change returns to a saved layout, ask before restoring it, restore it automatically, or do nothing. Automatic recovery always saves an undo checkpoint and pauses for fullscreen apps.'}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="TemporaryDisplayRecoveryModeCombo" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectedValuePath="Tag" SelectionChanged="OnTemporaryDisplayRecoveryModeChanged">
                                <ComboBoxItem Content="{shell:LocalizedText 'Ask before restoring'}" Tag="Ask"/>
                                <ComboBoxItem Content="{shell:LocalizedText 'Restore automatically'}" Tag="AutomaticallyRestore"/>
                                <ComboBoxItem Content="{shell:LocalizedText 'Do nothing'}" Tag="Disabled"/>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="{shell:LocalizedText 'Matching browser tabs'}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{shell:LocalizedText 'Choose whether a matching tab in the same browser profile is reused, reopened, or left for review.'}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="BrowserTabRestorePolicyCombo" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="OnBrowserTabRestorePolicyChanged">
