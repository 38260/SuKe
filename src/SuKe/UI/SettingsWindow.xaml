                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                                </StackPanel>
                            </Border><Border Style="{StaticResource WaCard}" Padding="14,16" Margin="0,0,0,14"><StackPanel x:Name="SectionPaths">

