                    </StackPanel>
                </MenuItem.Header></MenuItem></ContextMenu></Button.ContextMenu></Button></Grid><Border Background="{DynamicResource WaCardInnerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0">
                    <StackPanel><Grid MinHeight="64"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Globe24" FontSize="30" Width="42" Margin="4,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><StackPanel VerticalAlignment="Center" Grid.Column="1"><TextBlock Text="{shell:LocalizedText 'Browser Integration'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{shell:LocalizedText 'Use the installed extension to save and restore browser tabs'}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:Button x:Name="ChromeExtensionButton" Grid.Row="0" Grid.Column="2" Content="{shell:LocalizedText 'Set up Chrome'}" Icon="{ui:SymbolIcon Globe24}" HorizontalAlignment="Right" Margin="14,0,0,0" Click="OnChromeExtensionSetup" Style="{DynamicResource WaPrimaryAction}" MinHeight="44" FontSize="15"/>
                            </Grid></StackPanel></Border>

                                </StackPanel>
                                </Border><Border Style="{StaticResource WaCard}" Padding="14,16" Margin="0,0,0,14"><StackPanel x:Name="SectionMonitors">

