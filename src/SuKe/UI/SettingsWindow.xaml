                                 → Paths → Matching → Startup → Hotkeys）。两边不一致时，点选会跳到页面中段，
                                 滚动时的跟随高亮也会逆向跳动。 -->
                            <RadioButton x:Name="CategorySystem" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" IsChecked="True" Tag="{x:Static ui:SymbolRegular.Desktop24}" Content="{shell:LocalizedText 'System'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryAppearance" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.PaintBrush24}" Content="{shell:LocalizedText 'Appearance &amp; Language'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryRestore" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.ArrowCounterclockwise24}" Content="{shell:LocalizedText 'Restore Workflow'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryBrowser" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.Globe24}" Content="{shell:LocalizedText 'Browser Integration'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryMonitors" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.DesktopMac24}" Content="{shell:LocalizedText 'Monitors'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryPaths" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.FolderArrowRight24}" Content="{shell:LocalizedText 'Path Portability'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryMatching" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.AppsList24}" Content="{shell:LocalizedText 'Window Matching'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryStartup" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.Power24}" Content="{shell:LocalizedText 'Startup'}" Checked="OnSettingsCategoryChecked"/>
                            <RadioButton x:Name="CategoryHotkeys" Style="{StaticResource WaCategoryItem}" GroupName="WaSettingsCategory" Tag="{x:Static ui:SymbolRegular.Keyboard24}" Content="{shell:LocalizedText 'Keyboard Shortcuts'}" Checked="OnSettingsCategoryChecked"/>
                        </StackPanel>
                        </ScrollViewer>

                        </Border></Grid>
                </Grid>
            </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,0,0,8" Grid.Column="1" x:Name="StatusLine">
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,9,0" Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
                        <TextBlock x:Name="StatusText" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NavWorkspaces}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style></StackPanel>
                <Border Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/></Grid>
</ui:FluentWindow>
