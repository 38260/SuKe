                </StackPanel>
                        </ScrollViewer>
                    <Border Style="{StaticResource WaCard}" Padding="12" Margin="0,0,16,16" Grid.Column="0"><ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0">
