<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Shared visual language for the SuKe shell (workspace / activity / settings pages).

        Every surface colour is a WPF-UI DynamicResource so the whole dictionary follows the
        light and dark themes that ApplicationThemeManager.ApplySystemTheme() selects at startup.
        Keep new brushes here theme-aware: a literal colour is only acceptable for text that sits
        on the accent fill.
    -->

    <!-- ── Geometry ─────────────────────────────────────────────────────────── -->

    <CornerRadius x:Key="WaCardRadius">14</CornerRadius>
    <CornerRadius x:Key="WaControlRadius">10</CornerRadius>

    <!-- ── Text ─────────────────────────────────────────────────────────────── -->

    <Style x:Key="WaPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="WaPageSubtitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="WaSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="WaItemTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="WaItemMeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="WaItemSubtle" TargetType="TextBlock" BasedOn="{StaticResource WaItemMeta}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>

    <!--
        ── Compact page typography (workspaces / activity only) ──────────────────

        The two content pages carry far more text than the settings page, so they use a denser
        scale. These keys are derived from the shared styles above instead of replacing them:
        the settings page keeps WaPageTitle / WaPageSubtitle / WaItemTitle / WaItemMeta exactly
        as they were, and only the two pages opt in by name.
    -->

    <Style x:Key="WaPageTitleCompact" TargetType="TextBlock" BasedOn="{StaticResource WaPageTitle}">
        <Setter Property="FontSize" Value="26"/>
    </Style>

    <Style x:Key="WaPageSubtitleCompact" TargetType="TextBlock" BasedOn="{StaticResource WaPageSubtitle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="WaSectionTitleCompact" TargetType="TextBlock" BasedOn="{StaticResource WaSectionTitle}">
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="WaItemTitleCompact" TargetType="TextBlock" BasedOn="{StaticResource WaItemTitle}">
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="WaItemMetaCompact" TargetType="TextBlock" BasedOn="{StaticResource WaItemMeta}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ── Surfaces ─────────────────────────────────────────────────────────── -->

    <Style x:Key="WaCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource WaCardRadius}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="WaSettingCard" TargetType="Border" BasedOn="{StaticResource WaCard}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- A card that lifts on hover, used by the workspace and activity rows. -->
    <Style x:Key="WaHoverCard" TargetType="Border" BasedOn="{StaticResource WaCard}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WaDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- ── Icon badge ───────────────────────────────────────────────────────── -->

    <Style x:Key="WaIconBadge" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="{StaticResource WaControlRadius}"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="WaIconBadgeLarge" TargetType="Border" BasedOn="{StaticResource WaIconBadge}">
        <Setter Property="Width" Value="54"/>
        <Setter Property="Height" Value="54"/>
    </Style>

    <!-- ── Focus visual ─────────────────────────────────────────────────────── -->

    <Style x:Key="WaFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary navigation item (workspaces / activity / settings) ───────── -->

    <Style x:Key="WaNavItem" TargetType="RadioButton">
        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WaFocusVisual}"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="{Binding FontSize,                                    RelativeSource={RelativeSource AncestorType=RadioButton}}" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground,                                    RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{DynamicResource SubtleFillColorTransparentBrush}" CornerRadius="{StaticResource WaControlRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Leading accent pill: the mockup marks the current page with one. -->
                            <Border x:Name="Pill" Grid.Column="0" Width="6" Margin="0,0,18,0" CornerRadius="4" Visibility="Collapsed" Background="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            <ui:SymbolIcon x:Name="Icon" Grid.Column="1" Width="28" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" Margin="0,0,18,0"/>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WaSelectionBrush}"/>
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Settings category item ───────────────────────────────────────────── -->

    <Style x:Key="WaCategoryItem" TargetType="RadioButton" BasedOn="{StaticResource WaNavItem}">
        <Setter Property="Height" Value="52"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- ── Filter chip (activity page) ──────────────────────────────────────── -->

    <Style x:Key="WaFilterChip" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Margin" Value="0,0,10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WaFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!--
                        The unchecked surface is a tinted fill with a real stroke. A plain white
                        fill disappears into the light canvas, and a hard-coded white label then
                        became invisible on it, so both colours come from the active palette.
                    -->
                    <Border x:Name="Bd" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource WaControlRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="Icon" Width="20" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- Both values follow the chip so the checked (accent) state stays white. -->
                    <TextBlock Text="{Binding}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                               FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                               VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Status pill ──────────────────────────────────────────────────────── -->

    <Style x:Key="WaPill" TargetType="Border">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource WaControlRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="WaPillSuccess" TargetType="Border" BasedOn="{StaticResource WaPill}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
    </Style>

    <Style x:Key="WaPillWarning" TargetType="Border" BasedOn="{StaticResource WaPill}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
    </Style>

    <Style x:Key="WaPillNeutral" TargetType="Border" BasedOn="{StaticResource WaPill}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <!-- ── Timeline ─────────────────────────────────────────────────────────── -->

    <Style x:Key="WaTimelineConnector" TargetType="Border">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="WaTimelineDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>

    <Style x:Key="WaTimelineDotAccent" TargetType="Ellipse" BasedOn="{StaticResource WaTimelineDot}">
        <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="WaTimelineDotWarning" TargetType="Ellipse" BasedOn="{StaticResource WaTimelineDot}">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
    </Style>

    <!-- ── Compact icon-only button (the ⋯ affordance) ──────────────────────── -->

    <Style x:Key="WaIconButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WaFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource WaControlRadius}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A borderless, hover-only button used inside cards. -->
    <Style x:Key="WaSubtleButton" TargetType="Button" BasedOn="{StaticResource WaIconButton}">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
