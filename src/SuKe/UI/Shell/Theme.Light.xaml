<!--
    Graphite light palette for the SuKe shell.

    Mirrors every key in Theme.Dark.xaml with a light counterpart, so swapping the dictionary keeps
    the same layout hierarchy while inverting the surface/text relationship. Two entries stay
    saturated on purpose: AccentFillColorDefaultBrush and WaActionForegroundBrush are the accent
    button fill and the white label that sits on it, which must keep their contrast in both themes.
    AccentFillColorSecondaryBrush is a Banner surface with ordinary text on top, so the light value
    is a pale tint rather than the dark saturated blue.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Surfaces ─────────────────────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="WaCanvasBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F8FA" Offset="0"/>
        <GradientStop Color="#EDEFF3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaSidebarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F1F3F6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F7F8FA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D6E8FF" Offset="0"/>
        <GradientStop Color="#E8F2FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WaCardInnerBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WaCardInnerStrokeBrush" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DCE0E6"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E4E7EC"/>

    <!-- ── Controls ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#C9CFD8"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="WaSecondaryActionBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WaSecondaryActionBorderBrush" Color="#D3D9E1"/>

    <!-- ── Text ─────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#15181C"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4B5462"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6E7785"/>

    <!-- ── Accent ───────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#0B6FD1"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0B6FD1"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DCEBFF"/>
    <SolidColorBrush x:Key="AccentActionBorderBrush" Color="#2C87E0"/>
    <SolidColorBrush x:Key="WaActionForegroundBrush" Color="White"/>
</ResourceDictionary>
