<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        参考图的石墨层次与蓝色强调，仅供主窗口使用。

        这里只保留样式；所有颜色都来自可切换的调色板（Theme.Dark.xaml / Theme.Light.xaml），
        ThemeService 会在运行时替换整份调色板，因此本文件不得再出现字面颜色。
    -->
    <Style x:Key="WaReferenceButton" TargetType="Button">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="22,10"/>
    </Style>
    <Style x:Key="WaPrimaryAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Primary"/>
        <Setter Property="Foreground" Value="{DynamicResource WaActionForegroundBrush}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WaFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:Button">
            <Border x:Name="ActionSurface" Background="{DynamicResource AccentFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentActionBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="ActionIcon" Symbol="{Binding Icon.Symbol, RelativeSource={RelativeSource TemplatedParent}}" FontSize="24"
                                   Foreground="{DynamicResource WaActionForegroundBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" TextElement.Foreground="{DynamicResource WaActionForegroundBrush}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Appearance" Value="Secondary"><Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource WaSecondaryActionBrush}"/><Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource WaSecondaryActionBorderBrush}"/><Setter TargetName="ActionIcon" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Opacity" Value="0.72"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                       Foreground="{DynamicResource WaActionForegroundBrush}"/>
        </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WaSecondaryAction" TargetType="ui:Button" BasedOn="{StaticResource WaPrimaryAction}">
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="Background" Value="{DynamicResource WaSecondaryActionBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="14,7"/>
        <!-- A secondary action sits on an ordinary surface, so its label uses ordinary text colour. -->
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </DataTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
