<!--
    Graphite dark palette for the SuKe shell.

    This dictionary owns *values only*. Every key is duplicated in Theme.Light.xaml so the
    ThemeService can swap the two dictionaries at runtime and every DynamicResource lookup follows
    without rebuilding any window. Keep both files in sync: adding a key here without adding it to
    the light palette leaves that brush undefined in light mode.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Surfaces ─────────────────────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="WaCanvasBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B1D1F" Offset="0"/>
        <GradientStop Color="#171A1C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaSidebarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#242526" Offset="0"/>
        <GradientStop Color="#1C1E20" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#282A2C" Offset="0"/>
        <GradientStop Color="#222426" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#174B7B" Offset="0"/>
        <GradientStop Color="#1C354B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WaCardInnerBrush" Color="#232527"/>
    <SolidColorBrush x:Key="WaCardInnerStrokeBrush" Color="#383B3F"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#2C2F32"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3B3D40"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#383C40"/>

    <!-- ── Controls ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#44474B"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#303234"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#272A2D"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#393D42"/>
    <SolidColorBrush x:Key="WaSecondaryActionBrush" Color="#303234"/>
    <SolidColorBrush x:Key="WaSecondaryActionBorderBrush" Color="#454B52"/>

    <!-- ── Text ─────────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#BAC9DD"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A2B0C3"/>

    <!-- ── Accent ───────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#0095FF"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0089FF"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#007AE8"/>
    <SolidColorBrush x:Key="AccentActionBorderBrush" Color="#1D96FF"/>
    <SolidColorBrush x:Key="WaActionForegroundBrush" Color="White"/>
</ResourceDictionary>
