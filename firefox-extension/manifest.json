{
  "manifest_version": 2,
  "name": "SuKe Browser Connector",
  "version": "0.1.0",
  "description": "Captures and restores Firefox tabs for SuKe workspaces.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "SuKe Browser Connector",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "suke-browser-connector@suke.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "personallyIdentifyingInfo"
        ]
      }
    }
  }
}
